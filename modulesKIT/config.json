{
    "directories": {
        "data_directory": "./data/"
    },
    "tokens": {},
    "modules": {
        "anyquotes": {
            "port": 8001,
            "description": "Simple module that sends random quotes on demand...",
            "auto_start": true,
            "data": {
                "template": "```<quote>\n> <author>```**<source_file>**"
            }
        },
        "tb1": {
            "port": 8002,
            "description": "Terra Battle 1 companion: pact rolls, daily quest forecast, event info",
            "auto_start": true
        },
        "llm": {
            "port": 8003,
            "description": "Chat completions via a locally-running OpenAI-compatible server (e.g. llama.cpp's llama-server)",
            "auto_start": false,
            "data": {
                "base_url": "http://127.0.0.1:8080",
                "model": "local-model",
                "system_prompt": "You are a helpful assistant.",
                "max_tokens": "512",
                "temperature": "0.7",
                "timeout": "60"
            }
        }
    }
}